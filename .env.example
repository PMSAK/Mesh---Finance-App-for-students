# Server-side only. Never prefix with VITE_ (that would expose it to the browser bundle).
# Copy this file to .env.local and fill in the key to enable AI features.

# OpenAI API key used for receipt extraction and Money Coach analysis.
OPENAI_API_KEY=your_openai_api_key_here

# Optional: OpenAI model (default: gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

